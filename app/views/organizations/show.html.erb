<% if @organization.persisted? %>
  <div>
    <div class="flex items-center justify-between">
      <h1 class="font-bold text-4xl"><%= @organization.name %></h1>
      <div class="relative" data-controller="dropdown">
        <button type="button" data-action="dropdown#toggle" class="w-8 h-8 rounded-full border border-gray-300 hover:bg-gray-100 flex items-center justify-center text-gray-500" aria-label="Organization actions">
          <%= icon "ellipsis-vertical", class: "h-5 w-5" %>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-md shadow-lg z-10">
          <%= link_to edit_organization_path, class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" do %>
            <%= icon "pencil", class: "h-4 w-4" %> Edit
          <% end %>
        </div>
      </div>
    </div>

    <% if @organization.support_information.present? %>
      <%= @organization.support_information %>
    <% end %>

    <h2 class="font-bold text-2xl mt-8 pl-4">
      <%= link_to sites_path, class: "flex items-center gap-3 hover:underline" do %>
        <%= icon "map-pin", class: "h-8 w-8" %> Sites
      <% end %>
    </h2>
    <ul class="mt-4 pl-8 space-y-2">
      <% @organization.sites.each do |site| %>
        <li>
          <%= link_to site, class: "flex items-center gap-2 text-gray-700 underline hover:no-underline" do %>
            <%= icon "map-pin", class: "h-4 w-4" %> <%= site.name %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="text-gray-500 mt-4"><% if @organization.sites.none? %>No sites yet.<% end %></p>

    <h2 class="font-bold text-2xl mt-8 pl-4">
      <%= link_to devices_path, class: "flex items-center gap-3 hover:underline" do %>
        <%= icon "tv", class: "h-8 w-8" %> Devices
      <% end %>
    </h2>
    <% if (attention = Device.needing_support_attention).any? %>
      <p class="mt-4 pl-8 flex items-center gap-2 text-amber-800">
        <%= icon "exclamation-triangle", class: "h-4 w-4" %>
        <%= link_to "#{pluralize(attention.size, "Apple TV")} losing or past support", devices_path, class: "underline hover:no-underline" %>
      </p>
    <% end %>
  </div>
<% else %>
  <div>
    <h1 class="font-bold text-4xl">Welcome to WhatsUpNext</h1>
    <p>This instance hasn't been set up yet. Give your organization a name to get started.</p>

    <%= form_with model: @organization, url: organization_path do |f| %>
      <%= render "shared/form_errors", record: @organization %>

      <%= f.label :name %>
      <%= f.text_field :name %>
      <%= f.submit "Create organization" %>
    <% end %>
  </div>
<% end %>
