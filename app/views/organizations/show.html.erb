<% if @organization.persisted? %>
  <div>
    <h1 class="font-bold text-4xl"><%= @organization.name %></h1>

    <% if @organization.support_information.present? %>
      <%= @organization.support_information %>
    <% end %>

    <%= link_to "Edit", edit_organization_path %>

    <h2 class="font-bold text-2xl mt-8 pl-4">
      <%= link_to sites_path, class: "flex items-center gap-3 hover:underline" do %>
        <%= icon "map-pin", class: "h-8 w-8" %> Sites
      <% end %>
    </h2>
    <ul class="mt-4 pl-8 space-y-2">
      <% @organization.sites.each do |site| %>
        <li>
          <%= link_to site, class: "flex items-center gap-2 text-gray-700 underline hover:no-underline" do %>
            <%= icon "map-pin", class: "h-4 w-4" %> <%= site.name %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="text-gray-500 mt-4"><% if @organization.sites.none? %>No sites yet.<% end %></p>

    <h2 class="font-bold text-2xl mt-8 pl-4">
      <%= link_to devices_path, class: "flex items-center gap-3 hover:underline" do %>
        <%= icon "tv", class: "h-8 w-8" %> Devices
      <% end %>
    </h2>
  </div>
<% else %>
  <div>
    <h1 class="font-bold text-4xl">Welcome to WhatsUpNext</h1>
    <p>This instance hasn't been set up yet. Give your organization a name to get started.</p>

    <%= form_with model: @organization, url: organization_path do |f| %>
      <%= render "shared/form_errors", record: @organization %>

      <%= f.label :name %>
      <%= f.text_field :name %>
      <%= f.submit "Create organization" %>
    <% end %>
  </div>
<% end %>
