<div>
  <h1 class="font-bold text-4xl">Edit Organization</h1>

  <%= form_with model: @organization, url: organization_path do |f| %>
    <%= f.label :name %>
    <%= f.text_field :name %>

    <%= f.label :support_information %>
    <%= f.lexxy_rich_textarea :support_information %>

    <%= f.submit "Save" %>
  <% end %>
</div>
