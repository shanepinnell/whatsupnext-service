<%= form_with(model: [ @site, building ], class: "contents") do |form| %>
  <%= render "shared/form_errors", record: building %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": building.errors[:name].none?, "border-red-400 focus:outline-red-600": building.errors[:name].any?}] %>
  </div>

  <div class="my-5" data-controller="timezone-select">
    <%= form.label :timezone %>
    <%= form.select :timezone, TZInfo::Timezone.all_identifiers, { include_blank: "Select a timezone" }, { data: { "timezone-select-target": "select" }, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": building.errors[:timezone].none?, "border-red-400 focus:outline-red-600": building.errors[:timezone].any?}] } %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
