<% content_for :title, "Buildings" %>

<div class="w-full">
  <%= render "shared/breadcrumbs", crumbs: [[@site.name, site_path(@site)]] %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl flex items-center gap-3">
      <%= icon "building-office-2", class: "h-9 w-9" %>
      Buildings
    </h1>
    <%= link_to new_site_building_path(@site), class: "w-10 h-10 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center", aria: { label: "New building" } do %>
      <%= icon "plus", class: "h-6 w-6" %>
    <% end %>
  </div>

  <div id="buildings" class="min-w-full divide-y divide-gray-200 space-y-5 pl-4">
    <% if @buildings.any? %>
      <% @buildings.each do |building| %>
        <%= render building %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No buildings found.</p>
    <% end %>
  </div>
</div>
