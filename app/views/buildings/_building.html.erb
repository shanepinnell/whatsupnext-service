<div id="<%= dom_id building %>" class="w-full sm:w-auto my-5 space-y-5">
  <% if local_assigns.fetch(:show_name, true) %>
    <div class="flex items-center gap-2">
      <%= icon "building-office", class: "h-5 w-5" %>
      <%= link_to building.name, [ @site, building ], class: "hover:underline" %>
    </div>
  <% end %>
  <div>
    <strong class="block font-medium mb-1">Timezone:</strong>
    <%= building.timezone %>
  </div>
</div>
