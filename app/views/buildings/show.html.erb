<% content_for :title, "Showing building" %>

<div class="md:w-2/3 w-full">
  <%= render "shared/breadcrumbs", crumbs: [[@site.name, site_path(@site)], ["Buildings", site_buildings_path(@site)]] %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl flex items-center gap-3">
      <%= icon "building-office", class: "h-9 w-9" %>
      <%= @building.name %>
    </h1>
    <div class="relative" data-controller="dropdown">
      <button type="button" data-action="dropdown#toggle" class="w-8 h-8 rounded-full border border-gray-300 hover:bg-gray-100 flex items-center justify-center text-gray-500" aria-label="Building actions">
        <%= icon "ellipsis-vertical", class: "h-5 w-5" %>
      </button>
      <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-md shadow-lg z-10">
        <%= link_to edit_site_building_path(@site, @building), class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" do %>
          <%= icon "pencil", class: "h-4 w-4" %> Edit
        <% end %>
        <%= button_to [ @site, @building ], method: :delete, class: "w-full flex items-center gap-2 text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-50 bg-transparent border-0 cursor-pointer", data: { turbo_confirm: "Are you sure?" } do %>
          <%= icon "trash", class: "h-4 w-4" %> Destroy
        <% end %>
      </div>
    </div>
  </div>

  <%= render @building, show_name: false %>

  <h2 class="font-bold text-2xl mt-8 pl-4">
    <%= link_to site_building_floors_path(@site, @building), class: "flex items-center gap-3 hover:underline" do %>
      <%= icon "square-3-stack-3d", class: "h-8 w-8" %> Floors
    <% end %>
  </h2>
  <ul class="mt-4 pl-8 space-y-2">
    <% @building.floors.each do |floor| %>
      <li>
        <%= link_to [ @site, @building, floor ], class: "flex items-center gap-2 text-gray-700 underline hover:no-underline" do %>
          <%= icon "rectangle-stack", class: "h-4 w-4" %> <%= floor.name %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <p class="text-gray-500 mt-4"><% if @building.floors.none? %>No floors yet.<% end %></p>
</div>
