<% content_for :title, @device.name %>

<div class="md:w-2/3 w-full">
  <% if (room = @device.room) %>
    <% floor = room.floor %>
    <% building = floor.building %>
    <% site = building.site %>
    <%= render "shared/breadcrumbs", crumbs: [[site.name, site_path(site)], [building.name, site_building_path(site, building)], [floor.name, site_building_floor_path(site, building, floor)], ["Rooms", site_building_floor_rooms_path(site, building, floor)], [room.name, site_building_floor_room_path(site, building, floor, room)]] %>
  <% else %>
    <%= render "shared/breadcrumbs", crumbs: [["Devices", devices_path]] %>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl flex items-center gap-3">
      <%= icon "tv", class: "h-9 w-9" %>
      <%= @device.name %>
    </h1>
    <div class="relative" data-controller="dropdown">
      <button type="button" data-action="dropdown#toggle" class="w-8 h-8 rounded-full border border-gray-300 hover:bg-gray-100 flex items-center justify-center text-gray-500" aria-label="Device actions">
        <%= icon "ellipsis-vertical", class: "h-5 w-5" %>
      </button>
      <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-md shadow-lg z-10">
        <%= link_to edit_device_path(@device), class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" do %>
          <%= icon "pencil", class: "h-4 w-4" %> Edit
        <% end %>
      </div>
    </div>
  </div>

  <dl class="my-5 space-y-5">
    <div>
      <dt class="font-medium mb-1">Status</dt>
      <dd class="text-gray-700"><%= @device.status.humanize %></dd>
    </div>
    <div>
      <dt class="font-medium mb-1">Room</dt>
      <dd class="text-gray-700">
        <% if room %>
          <%= link_to room.name, site_building_floor_room_path(site, building, floor, room), class: "underline hover:no-underline" %>
        <% else %>
          Unassigned
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="font-medium mb-1">Paired</dt>
      <dd class="text-gray-700"><%= @device.paired_at ? "#{time_ago_in_words(@device.paired_at)} ago" : "Not yet" %></dd>
    </div>
    <div>
      <dt class="font-medium mb-1">Last seen</dt>
      <dd class="text-gray-700"><%= @device.last_seen_at ? "#{time_ago_in_words(@device.last_seen_at)} ago" : "Never" %></dd>
    </div>
  </dl>
</div>
