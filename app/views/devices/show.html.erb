<% content_for :title, @device.name %>

<% if (room = @device.room) %>
  <% floor = room.floor %>
  <% building = floor.building %>
  <% site = building.site %>
  <%= render "shared/breadcrumbs", crumbs: [[site.name, site_path(site)], [building.name, site_building_path(site, building)], [floor.name, site_building_floor_path(site, building, floor)], ["Rooms", site_building_floor_rooms_path(site, building, floor)], [room.name, site_building_floor_room_path(site, building, floor, room)]] %>
<% else %>
  <%= render "shared/breadcrumbs", crumbs: [["Devices", devices_path]] %>
<% end %>

<div class="flex items-center justify-between">
  <h1 class="font-bold text-4xl flex items-center gap-3">
    <%= icon "tv", class: "h-9 w-9" %>
    <%= @device.name %>
  </h1>
  <div class="relative" data-controller="dropdown">
    <button type="button" data-action="dropdown#toggle" class="w-8 h-8 rounded-full border border-gray-300 hover:bg-gray-100 flex items-center justify-center text-gray-500" aria-label="Device actions">
      <%= icon "ellipsis-vertical", class: "h-5 w-5" %>
    </button>
    <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-40 bg-white border border-gray-200 rounded-md shadow-lg z-10">
      <%= link_to edit_device_path(@device), class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" do %>
        <%= icon "pencil", class: "h-4 w-4" %> Edit
      <% end %>
      <%= button_to @device, method: :delete, class: "w-full flex items-center gap-2 text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-50 bg-transparent border-0 cursor-pointer", data: { turbo_confirm: "Delete this device? The TV will return to its pairing screen." } do %>
        <%= icon "trash", class: "h-4 w-4" %> Delete
      <% end %>
    </div>
  </div>
</div>

<div class="md:w-2/3 w-full">
  <% stage = @device.support_stage %>
  <% if stage != :supported && !@device.support_risk_accepted? %>
    <div class="mt-5 flex items-start gap-3 rounded-md border px-4 py-3 <%= stage == :unsupported ? "border-red-200 bg-red-50 text-red-700" : "border-amber-200 bg-amber-50 text-amber-800" %>">
      <%= icon (stage == :unsupported ? "exclamation-circle" : "exclamation-triangle"), class: "h-5 w-5 shrink-0" %>
      <div class="flex-1 space-y-3">
        <p>
          <% case stage %>
          <% when :losing_support %>
            Apple's next tvOS release drops the <%= @device.hardware_name %>. Support for this Apple TV ends 6 months after that release.
          <% when :deprecated %>
            The <%= @device.hardware_name %> no longer gets tvOS updates. Support ends <%= l @device.support_ends_on, format: :long %> — after that, this Apple TV stops showing room information unless an admin accepts the risk.
          <% when :unsupported %>
            The <%= @device.hardware_name %> no longer gets security updates. Support ended <%= l @device.support_ends_on, format: :long %>, and this Apple TV no longer shows room information.
          <% end %>
        </p>
        <%= button_to "Accept the risk", device_support_risk_acceptance_path(@device), class: "rounded-md border bg-white px-3 py-1.5 text-sm font-medium cursor-pointer #{stage == :unsupported ? "border-red-300 hover:bg-red-100" : "border-amber-300 hover:bg-amber-100"}", data: { turbo_confirm: "Keep using this Apple TV even though it's #{stage.to_s.humanize.downcase}?" } %>
      </div>
    </div>
  <% end %>
  <% if @device.tvos_update_available? %>
    <div class="mt-5 flex gap-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-amber-800">
      <%= icon "exclamation-triangle", class: "h-5 w-5 shrink-0" %>
      <p>This Apple TV is on tvOS <%= @device.os_version %>. We recommend updating.</p>
    </div>
  <% end %>

  <dl class="my-5 space-y-5">
    <div>
      <dt class="font-medium mb-1">Status</dt>
      <dd class="text-gray-700"><%= @device.status.humanize %></dd>
    </div>
    <div>
      <dt class="font-medium mb-1">Room</dt>
      <dd class="text-gray-700">
        <% if room %>
          <%= link_to room.name, site_building_floor_room_path(site, building, floor, room), class: "underline hover:no-underline" %>
        <% else %>
          Unassigned
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="font-medium mb-1">Paired</dt>
      <dd class="text-gray-700"><%= @device.paired_at ? "#{time_ago_in_words(@device.paired_at)} ago" : "Not yet" %></dd>
    </div>
    <div>
      <dt class="font-medium mb-1">Last seen</dt>
      <dd class="text-gray-700"><%= @device.last_seen_at ? "#{time_ago_in_words(@device.last_seen_at)} ago" : "Never" %></dd>
    </div>
  </dl>

  <% if @device.info_reported_at %>
    <h2 class="font-bold text-2xl mt-8 flex items-center gap-3">
      <%= icon "cpu-chip", class: "h-7 w-7" %> Hardware &amp; software
    </h2>
    <% if stage != :supported && @device.support_risk_accepted? %>
      <p class="mt-3 flex items-center gap-2 text-sm text-gray-500">
        <%= icon "shield-check", class: "h-4 w-4 shrink-0" %>
        <%= stage.to_s.humanize %>: risk accepted by <%= @device.support_risk_accepted_by&.email_address || "a removed admin" %> on <%= l @device.support_risk_accepted_at.to_date, format: :long %>.
      </p>
    <% end %>
    <dl class="my-5 space-y-5">
      <% { "Model" => @device.hardware_name,
           "tvOS" => @device.os_version,
           "App version" => @device.app_version,
           "Display" => (@device.display_width && "#{@device.display_width}×#{@device.display_height}#{" · HDR" if @device.display_hdr}"),
           "Network" => { "ethernet" => "Ethernet", "wifi" => "Wi-Fi", "other" => "Other" }[@device.network],
           "Last report" => "#{time_ago_in_words(@device.info_reported_at)} ago" }.compact.each do |label, value| %>
        <div>
          <dt class="font-medium mb-1"><%= label %></dt>
          <dd class="text-gray-700"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</div>
