<% content_for :title, "Rooms" %>

<div class="w-full">
  <%= render "shared/breadcrumbs", crumbs: [[@site.name, site_path(@site)], [@building.name, site_building_path(@site, @building)], [@floor.name, site_building_floor_path(@site, @building, @floor)]] %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl flex items-center gap-3">
      <%= icon "squares-2x2", class: "h-9 w-9" %>
      Rooms
    </h1>
    <%= link_to new_site_building_floor_room_path(@site, @building, @floor), class: "w-10 h-10 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center", aria: { label: "New room" } do %>
      <%= icon "plus", class: "h-6 w-6" %>
    <% end %>
  </div>

  <div id="rooms" class="min-w-full divide-y divide-gray-200 space-y-5 pl-4">
    <% if @rooms.any? %>
      <% @rooms.each do |room| %>
        <%= render room %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No rooms found.</p>
    <% end %>
  </div>
</div>
