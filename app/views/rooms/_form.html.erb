<%= form_with(model: [ @site, @building, @floor, room ], class: "contents") do |form| %>
  <%= render "shared/form_errors", record: room %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": room.errors[:name].none?, "border-red-400 focus:outline-red-600": room.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :background_image %>
    <%= form.file_field :background_image, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": room.errors[:background_image].none?, "border-red-400 focus:outline-red-600": room.errors[:background_image].any?}] %>
  </div>

  <fieldset class="my-5">
    <legend class="font-medium">Calendar</legend>

    <nav class="flex gap-4 border-b border-gray-200 mt-2">
      <%= link_to "ICS",
        room.persisted? ? edit_site_building_floor_room_path(@site, @building, @floor, room, provider: "ics") : new_site_building_floor_room_path(@site, @building, @floor, provider: "ics"),
        aria: { current: "page" },
        class: "-mb-px border-b-2 border-blue-600 px-1 py-2 font-medium text-blue-600" %>
    </nav>

    <%= form.fields_for :calendar_source, room.calendar_source || CalendarSource.new do |calendar_form| %>
      <%= calendar_form.hidden_field :provider, value: "ics" %>

      <div class="my-5">
        <%= calendar_form.label :url, "Calendar URL" %>
        <%= calendar_form.url_field :url, placeholder: "https://", class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": room.errors[:"calendar_source.config"].none?, "border-red-400 focus:outline-red-600": room.errors[:"calendar_source.config"].any?}] %>
      </div>

      <% if room.calendar_source&.persisted? %>
        <div class="my-5 flex items-center gap-2">
          <%= calendar_form.check_box :_destroy %>
          <%= calendar_form.label :_destroy, "Remove calendar" %>
        </div>
      <% end %>
    <% end %>
  </fieldset>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
