<% content_for :title, "Showing floor" %>

<div class="md:w-2/3 w-full">
  <%= render "shared/breadcrumbs", crumbs: [[@organization.name, root_path], [@site.name, site_path(@site)], [@building.name, site_building_path(@site, @building)], ["Floors", site_building_floors_path(@site, @building)]] %>

  <h1 class="font-bold text-4xl"><%= @floor.name %></h1>

  <%= render @floor %>

  <%= link_to "Edit this floor", edit_site_building_floor_path(@site, @building, @floor), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Manage rooms", site_building_floor_rooms_path(@site, @building, @floor), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to floors", site_building_floors_path(@site, @building), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Destroy this floor", [ @site, @building, @floor ], method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>

  <h2 class="font-bold text-2xl mt-8">Rooms</h2>
  <ul class="mt-4 space-y-2">
    <% @floor.rooms.each do |room| %>
      <li><%= link_to room.name, [ @site, @building, @floor, room ], class: "text-gray-700 underline hover:no-underline" %></li>
    <% end %>
  </ul>
  <p class="text-gray-500 mt-4"><% if @floor.rooms.none? %>No rooms yet.<% end %></p>
</div>
