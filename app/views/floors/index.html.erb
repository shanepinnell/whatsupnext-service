<% content_for :title, "Floors" %>

<div class="w-full">
  <%= render "shared/breadcrumbs", crumbs: [[@site.name, site_path(@site)], [@building.name, site_building_path(@site, @building)]] %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl flex items-center gap-3">
      <%= icon "square-3-stack-3d", class: "h-9 w-9" %>
      Floors
    </h1>
    <%= link_to new_site_building_floor_path(@site, @building), class: "w-10 h-10 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center", aria: { label: "New floor" } do %>
      <%= icon "plus", class: "h-6 w-6" %>
    <% end %>
  </div>

  <div id="floors" class="min-w-full divide-y divide-gray-200 space-y-5 pl-4">
    <% if @floors.any? %>
      <% @floors.each do |floor| %>
        <%= render floor %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No floors found.</p>
    <% end %>
  </div>
</div>
