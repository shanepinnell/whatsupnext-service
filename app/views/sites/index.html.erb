<% content_for :title, "Sites" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl flex items-center gap-3">
      <%= icon "map-pin", class: "h-9 w-9" %>
      Sites
    </h1>
    <%= link_to new_site_path, class: "w-10 h-10 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center", aria: { label: "New site" } do %>
      <%= icon "plus", class: "h-6 w-6" %>
    <% end %>
  </div>

  <div id="sites" class="min-w-full divide-y divide-gray-200 space-y-5 pl-4">
    <% if @sites.any? %>
      <% @sites.each do |site| %>
        <%= render site %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No sites found.</p>
    <% end %>
  </div>
</div>
