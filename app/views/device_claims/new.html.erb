<% content_for :title, "Pair a device" %>

<div class="md:w-2/3 w-full">
  <%= render "shared/breadcrumbs", crumbs: [[@site.name, site_path(@site)], [@building.name, site_building_path(@site, @building)], [@floor.name, site_building_floor_path(@site, @building, @floor)], ["Rooms", site_building_floor_rooms_path(@site, @building, @floor)], [@room.name, site_building_floor_room_path(@site, @building, @floor, @room)]] %>

  <h1 class="font-bold text-4xl flex items-center gap-3">
    <%= icon "tv", class: "h-9 w-9" %>
    Pair a device
  </h1>
  <p class="mt-2 text-gray-600">Enter the 6-digit code shown on the Apple TV to pair it with <%= @room.name %>.</p>

  <%= form_with url: site_building_floor_room_device_claim_path(@site, @building, @floor, @room), class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :code, "Pairing code" %>
      <%= form.text_field :code, value: params[:code], inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono text-2xl tracking-widest" %>
    </div>

    <div class="inline">
      <%= form.submit "Pair device", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>

  <%= link_to "Back to room", site_building_floor_room_path(@site, @building, @floor, @room), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
