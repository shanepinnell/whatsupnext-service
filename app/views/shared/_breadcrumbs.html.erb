<nav class="text-sm text-gray-500 mb-4">
  <% crumbs.each_with_index do |(label, path), index| %>
    <% if index > 0 %> / <% end %>
    <% if path %>
      <%= link_to label, path, class: "hover:text-gray-700 font-medium" %>
    <% else %>
      <span class="text-gray-700 font-medium"><%= label %></span>
    <% end %>
  <% end %>
</nav>
