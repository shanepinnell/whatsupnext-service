# Copy to .env, fill in real values, then run `dotenvx encrypt -f .env`.
# See service/CLAUDE.md for the full local-secrets setup. Never commit
# .env itself — only this .env.example template is tracked.

# Generate all three with `bin/rails db:encryption:init`
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Generate with `bin/rails secret`
SECRET_KEY_BASE=

# OIDC provider config (see SPEC.md's Authentication section) — one
# provider per deployed instance
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# This instance's own public host[:port] — used to build the OIDC
# callback redirect_uri
SERVICE_HOST=localhost:3000
